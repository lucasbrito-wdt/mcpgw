root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[go.mod]
indent_style = tab

[Makefile]
indent_style = tab

[*.{ts,tsx,js,mjs,mts,json,yml,yaml,css}]
indent_style = space
indent_size = 2

# Two trailing spaces are a hard line break in Markdown.
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
