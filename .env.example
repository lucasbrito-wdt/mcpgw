MCPGW_DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/mcp_gateway?sslmode=disable
MCPGW_LISTEN_ADDR=127.0.0.1:8787
MCPGW_PUBLIC_URL=http://localhost:8787
# base64 of 32 random bytes: openssl rand -base64 32
MCPGW_MASTER_KEY=

# Optional: serve net/http/pprof on this address (keep it on localhost)
# MCPGW_PPROF_ADDR=127.0.0.1:6060
# Optional: password for "mcpgw admin user create" (otherwise read from stdin)
# MCPGW_ADMIN_PASSWORD=
